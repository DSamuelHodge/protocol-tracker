{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "protocol-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "protocol-tracker",
      "database_id": "58401803-3b9c-4cad-964b-13674ed80312"
    }
  ],
  "vars": {
    "DEFAULT_TZ": "America/New_York"
  },
  "triggers": {
    // Matches the Withings access-token lifetime (3h) so the sync never has to do a
    // cold refresh; also pulls in new weight/activity/sleep data without opening the app.
    "crons": ["0 */3 * * *"]
  }
  // Secrets (not stored here):
  //   npx wrangler secret put API_TOKEN
  //   npx wrangler secret put WITHINGS_CLIENT_ID
  //   npx wrangler secret put WITHINGS_CLIENT_SECRET
  // Optional var if your worker's public URL differs from what Withings redirects to:
  //   "WITHINGS_REDIRECT_URI": "https://<your-worker-domain>/api/withings/callback"
}
